{
  "name": "starlit-tarot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/seo.ts && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "smoke": "node scripts/smoke.mjs",
    "build:github": "npm run build && node scripts/github-pages.mjs",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "check": "node scripts/check.mjs",
    "lint:tone": "tsx scripts/lint-tone.ts",
    "sample:readings": "tsx scripts/sample-readings.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.4",
    "@fontsource/noto-sans-thai": "^5.2.5",
    "@fontsource/noto-serif-thai": "^5.2.5",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
